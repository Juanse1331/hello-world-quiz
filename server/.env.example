ADMIN_PASSWORD=aceis2024   # Contrasena del panel admin
PORT=3000                  # Puerto del servidor

# --- Modo reto de programacion ---
PISTON_URL=http://127.0.0.1:2000   # Donde escucha Piston (docker compose en piston/)
RETO_ENVIOS_SIMULTANEOS=4          # Envios que se califican al mismo tiempo (subir si el PC es potente)
RETO_PRUEBAS_PARALELAS=3           # Pruebas de un mismo envio que corren en paralelo
RETO_ESPERA_ENVIO_S=3              # Segundos minimos entre dos envios del MISMO reto (desde que termina la calificacion)
RETO_MARGEN_RELOJ_MS=6000          # Margen de tiempo real sobre el limite de CPU de cada programa (PC saturado)
